# ==============================================================================
# Web Check Alert Discord - 設定例 (terraform.tfvars.example)
# ==============================================================================

# --- 基本設定 ---
# AWSリソースをデプロイするリージョン
region              = "ap-northeast-1"

# --- 監視対象の設定 ---
# 通知メッセージで使用するWebサイトの表示名（例：「My Website」が更新されました。）
web_site_name       = "My Website"

# 監視対象のWebサイトURL（プロトコルを含めて指定）
web_url             = "https://example.com"

# 監視のトリガーとなる既存の製品用S3バケット名
product_bucket_name = "your-product-bucket-name"

# --- 通知設定 ---
# DiscordのWebhook URL（機密情報）
discord_webhook_url = "https://discord.com/api/webhooks/..."

# --- 監視システム内部設定 (オプションで変更可能) ---
# 監視状態（ハッシュ値）を保存する専用バケット名
monitor_state_bucket_name = "web-check-monitor-state-bucket"

# SNSトピック名
sns_topic_name            = "web-check-alerts-topic"
